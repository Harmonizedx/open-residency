// OpenResidency data model.
// Deliberately minimal and privacy-preserving: the raw national ID is never stored.
// Only a tokenized subjectRef (HMAC of provider+id under a deployment pepper) is kept,
// so the residency register cannot be used to reconstruct foundational ID numbers.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here. The connection string reaches Migrate through
// prisma.config.ts and the client through a driver adapter (see src/prisma/prisma.service.ts),
// so DATABASE_URL remains the single environment variable a deployment sets.
datasource db {
  provider = "postgresql"
}

// One person's residency in this deployment.
//
// `subjectRef` is unique because a deployment is ONE subnational government: Katsina's
// instance issues Katsina residency and nothing else, so one person holds one record here
// and the constraint is a duplicate-enrolment guard rather than a limitation.
//
// A person's connections to OTHER jurisdictions are held by those jurisdictions' own
// deployments and reach this one as credentials to verify through the federation trust
// list -- never as rows in this table.
model Resident {
  id                 String    @id @default(uuid())
  residentId         String    @unique
  subjectRef         String    @unique
  countryCode        String
  subnationalUnit    String
  providerCode       String
  assuranceLevel     String
  // Applicant -> identity binding: HOW the applicant was proven to own this identity.
  // A foundational match alone is not owner proof, so the method is recorded explicitly.
  bindingMethod      String    @default("none")
  bindingRef         String? // opaque: auth txn, biometric match id, or enrolment operator id
  bindingAt          DateTime?
  bindingScore       Float? // biometric match score, when the subsystem reports one
  // Proof of residence: the assurance level achieved for this resident in their unit, how
  // it was established, and the unit it is anchored to. A foundational residence field is
  // recorded as register_declared_residence, never as origin.
  residenceAssurance String    @default("RAL0")
  residenceMethod    String    @default("self_declared")
  residenceUnit      String?
  residenceAsOf      DateTime?
  provisional        Boolean   @default(false)
  // ORCS §4.3: what this relationship states about itself over time. Added additively under
  // ORRA §15 -- every column either defaults or is nullable, so rows written before the
  // lifecycle existed read as an ACTIVE general residency rather than as having no status.
  // See docs/adr/0007-residency-status-is-lifecycle.md.
  //
  // `relationshipType` and `relationshipPurpose` are recorded because §4.3 requires them and
  // are never read in a decision path: the reason a person resides somewhere must not
  // determine what they can reach. No index on either, deliberately -- an index is an
  // invitation to filter by it.
  relationshipType   String    @default("GENERAL_RESIDENCY")
  relationshipPurpose String   @default("")
  relationshipStatus String    @default("ACTIVE")
  // Validity is recorded because §4.3 requires it. NOTHING expires on its own: a record past
  // validTo is still ACTIVE until somebody ends it (ADR-0007, Amendment 2).
  validFrom          DateTime?
  validTo            DateTime?
  policyVersion      String?
  evidenceRefs       String[]
  assuranceProfileId String?
  relationshipIssuer String?
  decidedBy          String?
  // The operator who took the application, distinct from what decided it.
  submittedBy        String?
  decidedAt          DateTime?
  endedAt            DateTime?
  endedReason        String?
  endedBy            String?
  // ORCS §10 credential lifecycle: what a status decision preserved. Distinct from the
  // relationship columns above -- this is about the key, those are about the person.
  credentialStatus   String    @default("ACTIVE")
  credentialReason   String?
  credentialAuthority String?
  credentialStatusAt DateTime?
  // Required for REVOKED by §10: a revocation a citizen cannot contest is a decision with no
  // remedy attached.
  appealPath         String?
  // Required for REPLACED by §10.
  supersededBy       String?
  credentialId       String?
  statusListIndex    Int
  // Minimized demographic attributes carried into the credential.
  fullName           String?
  givenName          String?
  familyName         String?
  dateOfBirth        String?
  gender             String?
  phoneHash          String? // for USSD/OTP binding and matching; one-way, cannot be dialled
  // AES-256-GCM ciphertext of the E.164 number, under a key held outside the database
  // (CONTACT_ENCRYPTION_KEY). Present only when contactDirectory.mode is `encrypted`:
  // a one-way hash cannot be dialled, so actually delivering a one-time code needs the
  // number back in a recoverable form. A database dump yields ciphertext only.
  phoneEnc           String?
  createdAt          DateTime  @default(now())
  // Set when this resident's personal data was erased. The row survives so the credential
  // stays revocable and its status-list index is never reused; what is gone is everything
  // that identifies a person.
  erasedAt           DateTime?

  @@index([countryCode, subnationalUnit])
}

// One growable revocation bitstring per country/deployment, plus a monotonic counter
// for assigning fresh status indices.
model StatusListState {
  countryCode String
  // ORCS §10 distinguishes SUSPENDED from REVOKED, so a jurisdiction publishes two lists and
  // a verifier can tell them apart. Defaulted, so the existing single row keeps its meaning.
  purpose     String   @default("revocation")
  encodedList String // gzip+base64url bitstring
  // The index counter belongs to the jurisdiction, not to a list: a resident occupies the same
  // index in both, so revocation and suspension refer to the same person. Only the revocation
  // row's counter is ever advanced.
  nextIndex   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([countryCode, purpose])
}

// A pending OpenID4VCI credential offer: the bridge between an enrollment desk and a
// citizen's wallet. Short-lived by design.
//
// The pre-authorized code and the transaction code are stored only as SHA-256 hashes.
// The raw code lives in the QR the citizen scans and nowhere else, so a dump of this
// table yields nothing that can be redeemed for a credential.
model CredentialOffer {
  id                    String    @id @default(uuid())
  preAuthorizedCodeHash String    @unique
  txCodeHash            String?
  residentId            String
  countryCode           String
  configurationIds      String[]
  expiresAt             DateTime
  redeemedAt            DateTime?
  // Wrong-PIN counter. A 6-digit tx_code is only safe if guesses are bounded.
  failedAttempts        Int       @default(0)
  createdAt             DateTime  @default(now())

  @@index([residentId])
  @@index([expiresAt])
}

// c_nonce values a wallet must sign over to prove key possession. Single-use: the unique
// primary key plus a delete-on-consume is what makes replay of a captured key proof fail.
model Oid4vciNonce {
  nonceHash String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// An in-flight OpenID4VP presentation request.
//
// Created by a relying party, answered by a wallet on a different connection, then polled
// for by the relying party -- three interactions that will not land on the same replica,
// which is why this is a table and not a map in memory.
//
// `status` is what makes a presentation single-use: the response endpoint only records an
// outcome while the request is still `pending`, so a captured vp_token replayed a second
// time cannot overwrite a verdict.
model PresentationRequest {
  id        String   @id @default(uuid())
  nonce     String   @unique
  clientId  String
  purpose   String
  reference String?
  status    String   @default("pending")
  outcome   Json?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Short-lived one-time codes for the sign-in fallback factor (and Aadhaar-style flows).
//
// The code itself is stored only as a hash; the plaintext exists only in the delivered
// message. `failedAttempts` bounds brute force, because a 6-digit code is only safe if the
// number of guesses against it is limited.
model OtpChallenge {
  id             String   @id @default(uuid())
  residentId     String
  codeHash       String
  channel        String
  expiresAt      DateTime
  consumed       Boolean  @default(false)
  failedAttempts Int      @default(0)
  createdAt      DateTime @default(now())

  // Composite rather than residentId alone: the per-resident rate limit reads every
  // challenge for a resident within a rolling window, so the window bound belongs in the
  // index. Serves the old residentId-only lookups too, as its leftmost prefix.
  @@index([residentId, createdAt])
}

// Tamper-evident audit log. Each row is hash-chained to the previous (prevHash),
// so any later edit or deletion is detectable by recomputing the chain.
model AuditEvent {
  seq         Int      @id
  eventId     String   @unique
  timestamp   DateTime
  action      String
  actor       String
  target      String?
  countryCode String?
  outcome     String
  metadata    Json?
  prevHash    String
  hash        String
  // Set when this event's personal data was redacted under an erasure request. The row and
  // its hash stay: the hash still commits to the original content, so the redaction is
  // provable rather than a silent edit.
  redactedAt  DateTime?

  @@index([target])
  @@index([action])
}

// A member of staff who may perform privileged actions.
//
// This exists so the audit log can name a person. Previously every privileged route was
// authenticated by one shared static API key, so an enrolment and a revocation both
// recorded the literal actor 'admin' and the log could not say who did either.
//
// Populated only when operatorAuth.mode is `local`. Under `oidc` the ministry's own
// directory is authoritative and a row here is optional -- used to add roles, or to
// disable an account locally as a kill switch that works even if IdP de-provisioning lags.
model Operator {
  id              String    @id @default(uuid())
  email           String    @unique
  displayName     String
  roles           String[]
  // scrypt$<salt>$<hash>. Null for operators that exist only to carry roles for an IdP
  // identity, which have no local password to steal.
  passwordHash    String?
  // Base32 TOTP secret. Confirmed on first successful use; once confirmed the second
  // factor is enforced regardless of the requireMfa setting.
  totpSecret      String?
  totpConfirmedAt DateTime?
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  disabledAt      DateTime?
  createdAt       DateTime  @default(now())

  keys OperatorKey[]
}

// A long-lived credential for a machine caller (an enrolment kiosk, a batch job).
//
// Stored only as a SHA-256 hash, like every other credential here. `expiresAt` plus
// `rotatedFrom` are what make rotation real: two keys are valid at once during an overlap
// window, so callers move across one at a time instead of every client cutting over on a
// single restart -- which was the only option with the shared static key.
model OperatorKey {
  id          String    @id @default(uuid())
  operatorId  String
  label       String
  keyHash     String    @unique
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  rotatedFrom String?
  createdAt   DateTime  @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

// First-class consent records for cross-sector data sharing over SSO. Revocable,
// and each grant is backed by a signed, portable receipt (receiptId).
model ConsentRecord {
  id               String    @id
  subjectRef       String
  residentId       String
  relyingParty     String
  relyingPartyName String?
  purpose          String
  scopes           String[]
  status           String    @default("active")
  grantedAt        DateTime
  expiresAt        DateTime?
  revokedAt        DateTime?
  receiptId        String
  // The OIDC grant this consent authorizes, when created through the SSO consent step.
  // Revoking the consent revokes this grant and every token issued under it; without the
  // link the two stores drift and a withdrawn consent keeps releasing claims.
  grantId          String?

  // ORCS §9 accountability. The controller and legal basis are what a regulator asks for
  // first; the evidence is what a disputed grant is checked against.
  controller           String  @default("")
  processor            String?
  dataCategories       String[]
  legalBasisReference  String  @default("")
  evidenceMethod       String  @default("")
  evidenceAt           DateTime?
  evidenceReference    String  @default("")
  evidenceCapturedBy   String?
  // §9 Replace: the previous record is preserved and a new version created, so the chain is
  // explicit rather than two rows both claiming to be live.
  version          Int       @default(1)
  supersedesId     String?
  supersededById   String?
  withdrawnBy      String?

  @@index([residentId])
  @@index([relyingParty])
}

// A lawful basis for processing (ORCS §9). Every `legalBasisReference` on a consent record
// resolves through the registry backed by this table plus the built-in consent basis.
//
// Deactivation is recorded, never a delete: a consent granted under a since-repealed by-law
// must stay readable, and an auditor asking what authority was relied on needs the answer.
model LegalBasis {
  id                 String    @id
  kind               String
  name               String
  instrument         String
  jurisdiction       String
  controller         String
  version            String
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  deactivatedAt      DateTime?
  deactivationReason String?
  deactivatedBy      String?
}

// A passkey (WebAuthn credential) enrolled to a resident. The private key never leaves the
// resident's device; only the public key and the clone-detection counter are stored here.
model WebAuthnCredential {
  id           String    @id @default(uuid())
  // base64url credential id from the authenticator. Unique across residents.
  credentialId String    @unique
  residentId   String
  // Public key as a JWK (JSON), plus its JOSE alg (EdDSA / ES256 / RS256).
  publicJwk    Json
  alg          String
  // Authenticator signature counter; a value that fails to advance signals a clone.
  signCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([residentId])
}

// A single-use, time-bound WebAuthn ceremony challenge (registration or authentication).
model WebAuthnChallenge {
  id         String   @id @default(uuid())
  residentId String
  challenge  String
  purpose    String
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([residentId])
}

// State belonging to the OpenID Connect provider itself: sessions, interactions,
// authorization codes, access and refresh tokens, grants.
//
// oidc-provider keeps this in process memory unless an adapter is configured, which breaks
// sign-in across replicas -- the authorization code is minted on the citizen's redirect and
// redeemed by the relying party's backend on a separate connection that load-balances
// independently. Same reasoning as PresentationRequest above: an interaction spanning more
// than one connection needs a table.
//
// `payload` is the record of truth. grantId / uid / userCode are lifted out of it into
// columns only so the lookups oidc-provider performs can be indexed.
model OidcStoredItem {
  // The oidc-provider model name ('Session', 'AuthorizationCode', ...). Ids are only unique
  // within a model, so the key is the pair.
  name       String
  id         String
  payload    Json
  grantId    String?
  uid        String?
  userCode   String?
  // Null means the model never expires; a past value is filtered on read and swept later.
  expiresAt  DateTime?
  // Set when a single-use artefact is redeemed. Read back as `consumed` so a replayed
  // authorization code is recognised as spent.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@id([name, id])
  @@index([name, grantId])
  @@index([name, uid])
  @@index([name, userCode])
  @@index([expiresAt])
}

// A refused residency application.
//
// Recorded so a refusal is a decision somebody can be held to and an applicant can contest,
// rather than a return value that vanished. Same requirement ORCS §10 places on revocation,
// at the point of entry instead of exit.
//
// Deliberately NOT a database of people who failed verification: `subjectRef` is set only
// when the foundational check succeeded and produced a tokenized reference. A refusal raised
// before an identity was established carries no identifier at all. See
// src/core/residency/refusal.ts.
model ResidencyRefusal {
  // The reference handed to the applicant. Unguessable, because knowing it is what proves
  // they are the person refused.
  reference       String   @id
  countryCode     String
  subnationalUnit String
  subjectRef      String?
  reason          String
  decidedBy       String
  // The operator who took the application, distinct from what decided it.
  submittedBy     String?
  appealPath      String
  // Where the applicant obtains HUMAN review, set when software refused them alone
  // (NDPA 2023 s.37, GDPR Art.22, Convention 108+).
  humanReviewPath String?
  // A review that cannot change the outcome is not a review, so `overturned` is a real state.
  reviewStatus    String   @default("none")
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  refusedAt       DateTime @default(now())

  @@index([subjectRef])
  @@index([countryCode, refusedAt])
}
