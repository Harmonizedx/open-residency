{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2022",
    "moduleResolution": "nodenext",
    "declaration": false,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    // No "incremental" here, deliberately. nest-cli.json sets deleteOutDir, so every build
    // removes dist/ before compiling; an incremental build then consults .tsbuildinfo, finds
    // no sources changed, and emits nothing -- leaving dist/ EMPTY while tsc exits 0. The
    // failure is silent, and surfaces much later as "Cannot find module '../dist/app.module'"
    // from the e2e harness. The cache buys nothing once the output is deleted anyway.
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "types": ["node"],
    "lib": ["ES2022"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-core", "scripts"]
}
