{
  "name": "open-residency",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source subnational trust infrastructure that lets governments establish, manage and exchange verified, purpose-scoped jurisdictional relationships between residents and their jurisdictions — giving citizens inclusive, privacy-preserving access to public services. A Digital Public Good.",
  "license": "Apache-2.0",
  "author": "Chinonso Williams <nonso@harmonizedx.com>",
  "contributors": [
    "HarmonizedX Limited"
  ],
  "homepage": "https://github.com/Harmonizedx/open-residency",
  "repository": {
    "type": "git",
    "url": "https://github.com/Harmonizedx/open-residency.git"
  },
  "bugs": {
    "url": "https://github.com/Harmonizedx/open-residency/issues"
  },
  "keywords": [
    "digital-public-good",
    "digital-identity",
    "verifiable-credentials",
    "residency",
    "openid-connect",
    "dpi"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "smoke": "tsc -p tsconfig.core.json && node dist-core/scripts/smoke.js",
    "smoke:sources": "tsc -p tsconfig.core.json && node dist-core/scripts/sources-smoke.js",
    "test": "npm run smoke && npm run smoke:sources && npm run smoke:ratelimit && npm run smoke:identifier-namespace && npm run smoke:oid4vci && npm run smoke:inji && npm run smoke:oid4vp && npm run smoke:sso && npm run smoke:federation && npm run smoke:ld-suites && npm run smoke:webauthn && npm run smoke:webauthn-service && npm run smoke:biometric && npm run smoke:statistics && npm run smoke:privacy && npm run smoke:assurance && npm run smoke:consent && npm run smoke:lifecycle && npm run smoke:credential-lifecycle && npm run smoke:refusal && npm run smoke:identity-links && npm run smoke:address-anchor && npm run smoke:unit-codes && npm run smoke:residence-rules && npm run smoke:delivery && npm run smoke:access-log && npm run smoke:sso-oidc && npm run smoke:upstream-oidc && npm run smoke:mosip-ida && npm run smoke:operator && npm run smoke:observability && npm run smoke:hsm && npm run smoke:gcpkms && npm run smoke:awskms && npm run test:conformance",
    "smoke:oid4vci": "tsc -p tsconfig.core.json && node dist-core/scripts/oid4vci-smoke.js",
    "smoke:oid4vp": "tsc -p tsconfig.core.json && node dist-core/scripts/oid4vp-smoke.js",
    "test:conformance": "tsc -p tsconfig.core.json && node dist-core/scripts/conformance.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:arch": "depcruise src scripts --config .dependency-cruiser.cjs",
    "lint:licenses": "bash scripts/check-license-headers.sh",
    "test:w3c": "bash scripts/run-w3c-suite.sh",
    "smoke:sso": "tsc -p tsconfig.core.json && node dist-core/scripts/sso-smoke.js",
    "smoke:federation": "tsc -p tsconfig.core.json && node dist-core/scripts/federation-smoke.js",
    "smoke:webauthn": "tsc -p tsconfig.core.json && node dist-core/scripts/webauthn-smoke.js",
    "smoke:operator": "tsc -p tsconfig.core.json && node dist-core/scripts/operator-smoke.js",
    "smoke:hsm": "tsc -p tsconfig.core.json && node dist-core/scripts/hsm-smoke.js",
    "smoke:gcpkms": "tsc -p tsconfig.core.json && node dist-core/scripts/gcpkms-smoke.js",
    "smoke:awskms": "tsc -p tsconfig.core.json && node dist-core/scripts/awskms-smoke.js",
    "smoke:sso-oidc": "tsc -p tsconfig.core.json && node dist-core/scripts/sso-oidc-smoke.js",
    "test:sso-e2e": "bash scripts/run-sso-nest-e2e.sh",
    "smoke:webauthn-service": "tsc -p tsconfig.core.json && node dist-core/scripts/webauthn-service-smoke.js",
    "smoke:inji": "tsc -p tsconfig.core.json && node dist-core/scripts/inji-conformance-smoke.js",
    "smoke:biometric": "tsc -p tsconfig.core.json && node dist-core/scripts/biometric-smoke.js",
    "smoke:statistics": "tsc -p tsconfig.core.json && node dist-core/scripts/statistics-smoke.js",
    "conformance:orcs": "tsc -p tsconfig.core.json && node dist-core/scripts/orcs-conformance.js",
    "smoke:privacy": "tsc -p tsconfig.core.json && node dist-core/scripts/privacy-smoke.js",
    "smoke:ld-suites": "tsc -p tsconfig.core.json && node dist-core/scripts/ld-suites-smoke.js",
    "smoke:upstream-oidc": "tsc -p tsconfig.core.json && node dist-core/scripts/upstream-oidc-smoke.js",
    "smoke:mosip-ida": "tsc -p tsconfig.core.json && node dist-core/scripts/mosip-ida-smoke.js",
    "conformance:mosip": "tsc -p tsconfig.core.json && node dist-core/scripts/mosip-conformance.js",
    "smoke:assurance": "tsc -p tsconfig.core.json && node dist-core/scripts/assurance-smoke.js",
    "smoke:consent": "tsc -p tsconfig.core.json && node dist-core/scripts/consent-smoke.js",
    "smoke:lifecycle": "tsc -p tsconfig.core.json && node dist-core/scripts/lifecycle-smoke.js",
    "smoke:credential-lifecycle": "tsc -p tsconfig.core.json && node dist-core/scripts/credential-lifecycle-smoke.js",
    "smoke:refusal": "tsc -p tsconfig.core.json && node dist-core/scripts/refusal-smoke.js",
    "smoke:address-anchor": "tsc -p tsconfig.core.json && node dist-core/scripts/address-anchor-smoke.js",
    "smoke:unit-codes": "tsc -p tsconfig.core.json && node dist-core/scripts/unit-codes-smoke.js",
    "smoke:residence-rules": "tsc -p tsconfig.core.json && node dist-core/scripts/residence-rules-smoke.js",
    "smoke:delivery": "tsc -p tsconfig.core.json && node dist-core/scripts/delivery-smoke.js",
    "smoke:access-log": "tsc -p tsconfig.core.json && node dist-core/scripts/access-log-smoke.js",
    "test:store-e2e": "bash scripts/run-store-e2e.sh",
    "smoke:identifier-namespace": "tsc -p tsconfig.core.json && node dist-core/scripts/identifier-namespace-smoke.js",
    "smoke:ratelimit": "tsc -p tsconfig.core.json && node dist-core/scripts/ratelimit-smoke.js",
    "smoke:observability": "tsc -p tsconfig.core.json && node dist-core/scripts/observability-smoke.js",
    "lint:openapi": "tsc -p tsconfig.core.json && node dist-core/scripts/openapi-drift.js",
    "sdk:generate": "bash scripts/sdk-generate.sh",
    "release:check": "bash scripts/check-release-versions.sh",
    "smoke:identity-links": "tsc -p tsconfig.core.json && node dist-core/scripts/identity-link-smoke.js",
    "keys:issuer": "node scripts/generate-issuer-key.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "js-yaml": "^5.3.0",
    "jsonld": "^9.0.0",
    "oidc-provider": "^9.12.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rdf-canonize": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@types/express": "^5.0.6",
    "@types/jsonld": "^1.5.15",
    "@types/node": "^26.6.3",
    "@types/oidc-provider": "^9.12.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "dependency-cruiser": "^18.4.0",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "pkcs11js": "^2.1.7"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "mysql2": "^3.24.4"
  }
}
