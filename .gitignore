# Dependencies
node_modules/

# Build output
dist/
dist-core/
*.tsbuildinfo

# Secrets and local configuration. Never commit a real issuer key, a foundational ID
# gateway credential, or an admin API key.
.env
.env.*
!.env.example
*.pem
*.key

# Test and tooling artifacts
coverage/
.nyc_output/
w3c-report.json

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# The W3C test suite is cloned on demand by npm run test:w3c
test/w3c/.suite/

# Local specification working documents. The ORCS and ORRA sources are circulated
# separately, and the gap analysis derived from them is a working note rather than a
# published artifact -- so a `git add -A` must not sweep any of them into the repository.
docs/*.docx
docs/ORCS-GAP-ANALYSIS.md
