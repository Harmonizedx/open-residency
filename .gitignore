# Dependencies
node_modules/

# Build output
dist/
dist-core/
*.tsbuildinfo

# Secrets and local configuration. Never commit a real issuer key, a foundational ID
# gateway credential, or an admin API key.
.env
.env.*
!.env.example
*.pem
*.key

# Test and tooling artifacts
coverage/
.nyc_output/
w3c-report.json

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# The W3C test suite is cloned on demand by npm run test:w3c
test/w3c/.suite/

# The ORCS and ORRA specification sources are circulated separately and are never committed:
# they are cited by identifier and section (`ORCS §8`, `ORRA §14`), never by committed path.
# The migration notes derived from them ARE tracked -- docs/architecture/ and docs/adr/ are the
# project's record of how the specification is being implemented.
docs/*.docx
